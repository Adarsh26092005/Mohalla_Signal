# ==============================================
# Mohalla Signal Backend Environment Variables Template
# Copy this file to .env for local development
# NEVER commit the actual .env file or real secrets to git.
# ==============================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Security & CORS
# Comma-separated list of allowed origins (e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK Configuration
# Used strictly backend-side to verify client Firebase ID tokens
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, escape newlines with \n when placing in .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Database (PostgreSQL - Source of Truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mohalla_signal?schema=public

# Redis & Queues (Volatile cache, rate limiting, and BullMQ background aggregation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Mohalla Signal Privacy & Aggregation Thresholds
# Minimum distinct merchants required before a neighborhood demand signal becomes visible
DEMAND_MERCHANT_THRESHOLD=3
DEMAND_AGGREGATION_WINDOW_HOURS=72
